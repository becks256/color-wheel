{
  "name": "@color-wheel/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo React Native reader for circular Color Wheel codes.",
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan --port 8082 --clear",
    "start:tunnel": "expo start --host tunnel --port 8082 --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@color-wheel/codec": "0.1.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "jpeg-js": "^0.4.4",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  }
}
