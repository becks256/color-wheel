    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "expo": "54.0.34",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
